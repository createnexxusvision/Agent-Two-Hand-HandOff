# Sandbox values only. Never put live or production keys here.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Gate 1 only: two sandbox personal accounts that receive $1.00 test payouts
GATE_PAYEE_EMAIL_1=
GATE_PAYEE_EMAIL_2=

# AI: Gemini is used when its key is set (free tier at aistudio.google.com); Claude otherwise.
# Force one with HANDOFF_AI_PROVIDER=google or anthropic. Override models with HANDOFF_MODEL_OPS, _VERIFIER, _EXPLAINER.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
HANDOFF_AI_PROVIDER=

# Database: leave empty locally to use the embedded database (data resets on restart). Render sets this for you.
DATABASE_URL=

# Trust layer: 32 random bytes each, base64. Optional locally (public demo keys are used); required on Render, which generates them.
TRUST_MASTER_KEY=
TRUST_SIGNING_SEED=

# Approval threshold in USD above which the creator must approve a payout
APPROVAL_THRESHOLD_USD=100

# Optional privacy layer (roadmap). Keep "off": the money loop never depends on it
PRIVACY=off
MIDNIGHT_NETWORK=preprod
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
MIDNIGHT_CONTRACT_ADDRESS=

# Sandbox values only. Never put live or production keys here.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# AI
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgres://user:password@localhost:5432/handoff

# Trust layer: master key that wraps per-record data keys (32 random bytes, base64)
TRUST_MASTER_KEY=

# Approval threshold in USD above which the creator must approve a payout
APPROVAL_THRESHOLD_USD=100

# Privacy layer on Midnight Preprod: set to "off" to run without it
PRIVACY=off
MIDNIGHT_NETWORK=preprod
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
MIDNIGHT_CONTRACT_ADDRESS=
